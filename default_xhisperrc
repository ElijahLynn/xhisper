# xhisper configuration: copy to ~/.config/xhisper/xhisperrc and edit.
# Every setting is optional; these are the defaults. See README.md for details.

# How the transcription is inserted: paste (all at once via the clipboard, which
# is restored afterwards) or type (one key per character).
insert-mode : paste

# Paste shortcut: auto (Ctrl+Shift+V in terminals, Ctrl+V elsewhere; needs the
# indicator extension to see the focused app), ctrl+v, or ctrl+shift+v.
paste-key : auto

# Recording indicator (GNOME Shell extension in extension/).
indicator-color : red      # red, orange, yellow, green, blue, purple, pink, white
indicator-style : meter    # meter (level bars) or orb (pulsing orb)

# Transcription
transcription-prompt     : ""     # optional context words; keep it short
long-recording-threshold : 1000   # seconds; longer recordings use whisper-large-v3

# Peak volume (dB) below which a recording counts as silent and is ignored.
silence-threshold : -50

# type mode only
type-key-gap            : 2000    # microseconds between keys; raise if an app drops keys
non-ascii-initial-delay : 0.15    # seconds after the first pasted non-ASCII character
non-ascii-default-delay : 0.025   # seconds after each following one
