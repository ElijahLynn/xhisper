# xhisper configuration
# Copy to ~/.config/xhisper/xhisperrc and customize
# When in doubt, check by running 'xhisper --log'

# Transcription Settings:
long-recording-threshold : 1000
transcription-prompt     : ""

# Paste Timing (seconds):
non-ascii-initial-delay : 0.15 # Increase this if first character comes out wrong.
non-ascii-default-delay : 0.025

# ASCII key gap (microseconds after each key). Default matches built-in speed.
# Raise only if a target app drops keys (e.g. Warp pegs the GPU and drops spaces).
type-key-gap : 2000

# Silence Detection:
silence-threshold  : -50
silence-percentage : 95

# How the transcription is inserted: "type" (key by key) or "paste" (all at once
# via the clipboard; your previous clipboard text is restored afterwards).
insert-mode : type
# Paste shortcut for insert-mode paste: auto (ctrl+shift+v in terminals, ctrl+v
# elsewhere; needs the xhisper-indicator extension to see the focused app), ctrl+v,
# or ctrl+shift+v.
paste-key : auto

# Recording indicator (needs the xhisper-indicator GNOME Shell extension in extension/;
# without it there is no indicator).
indicator-color : red
indicator-style : meter
