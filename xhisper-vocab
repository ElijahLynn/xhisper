#!/usr/bin/env python3
"""xhisper-vocab: build the automatic vocabulary that xhisper sends to Whisper as a
spelling hint, from words you type yourself.

Source: your messages in Claude Code transcripts (~/.claude/projects/*/*.jsonl) from
the last 60 days, plus folder names under ~/projects. A term qualifies when you used
it at least twice and it isn't an everyday English word Whisper already spells
right. Writes the best terms, one per line, to ~/.cache/xhisper/vocab.

xhisper runs this in the background at most once a day; run it by hand to rebuild
now. Prints the vocabulary with --print.
"""

import collections
import glob
import json
import math
import os
import re
import sys
import time

HOME = os.path.expanduser("~")
CACHE = os.environ.get("XDG_CACHE_HOME", f"{HOME}/.cache")
OUT = f"{CACHE}/xhisper/vocab"
TRANSCRIPTS = os.environ.get("XHISPER_VOCAB_TRANSCRIPTS", f"{HOME}/.claude/projects/*/*.jsonl")
PROJECTS = os.environ.get("XHISPER_VOCAB_PROJECTS", f"{HOME}/projects")
WORDLISTS = ["/usr/share/dict/words", "/usr/share/dict/american-english",
             "/usr/share/dict/british-english", "/usr/share/dict/cracklib-small"]

DAYS = 60            # only messages this recent
HALF_LIFE = 30       # days; recent use counts more
MIN_COUNT = 2        # "typed a few times"
MAX_TERMS = 80       # xhisper trims further to fit Whisper's prompt budget
MAX_MESSAGE = 2000   # longer user messages are mostly pasted logs or code

# Apostrophes stay attached so "isn't" isn't counted as "isn" (such tokens are dropped).
TOKEN = re.compile(r"[A-Za-z][A-Za-z0-9]*(?:[-_'\u2019][A-Za-z0-9]+)*")


def common_words():
    words = set()
    for path in WORDLISTS:
        try:
            with open(path, errors="ignore") as f:
                words.update(w.strip().lower() for w in f if w.strip())
        except OSError:
            pass
    return words


def message_texts(entry):
    """The prose you typed in one transcript entry (not tool results or system text)."""
    if entry.get("type") != "user":
        return
    content = entry.get("message", {}).get("content")
    parts = [content] if isinstance(content, str) else [
        c.get("text", "") for c in content or [] if isinstance(c, dict) and c.get("type") == "text"]
    for text in parts:
        if not text or text.lstrip().startswith("<") or len(text) > MAX_MESSAGE:
            continue
        text = re.sub(r"```.*?```", " ", text, flags=re.S)        # fenced code
        text = re.sub(r"(?:https?://|www\.)\S+|\S+@\S+", " ", text)  # URLs, emails
        text = re.sub(r"\S*[/\\]\S*", " ", text)                   # paths
        text = re.sub(r"\S+\.\S+", " ", text)                      # domains, file.ext
        yield text


def is_common(low, common):
    """An everyday word, an inflection of one (downloading, uploader) or a typo one
    letter away from one (custome, accuracty)."""
    if low in common:
        return True
    for suffix, repl in (("ing", ""), ("ing", "e"), ("ed", ""), ("ed", "e"), ("d", ""),
                         ("es", ""), ("s", ""), ("er", ""), ("er", "e"), ("ly", "")):
        if low.endswith(suffix) and low[:-len(suffix)] + repl in common:
            return True
    for i in range(3, len(low) - 2):                   # compound: laptop, sandbox
        if low[:i] in common and low[i:] in common:
            return True
    if len(low) >= 4:
        letters = "abcdefghijklmnopqrstuvwxyz"
        for i in range(len(low) + 1):
            if i < len(low) and low[:i] + low[i + 1:] in common:            # extra letter
                return True
            if i < len(low) and any(low[:i] + c + low[i + 1:] in common for c in letters):
                return True                                               # wrong letter
            if any(low[:i] + c + low[i:] in common for c in letters):     # missing letter
                return True
            if i < len(low) - 1 and low[:i] + low[i + 1] + low[i] + low[i + 2:] in common:
                return True                                               # swapped letters
    return False


def interesting(tok, common, name=False):
    """name: you capitalized it mid-sentence, so it's a proper name; only an exact
    dictionary word is dropped then (Supabase isn't "sup" + "abase")."""
    low = tok.lower()
    if len(tok) < 3 or "_" in tok or "'" in tok or "\u2019" in tok:
        return False                                   # code, contraction
    if tok.isupper():                                  # SQL, env vars, acronyms
        return False                                   # (Whisper writes acronyms fine)
    parts = re.split(r"[-_]", low)
    if any(re.fullmatch(r"[0-9a-f]+", p) and re.search(r"\d", p) for p in parts):
        return False                                   # hex IDs, hashes, branch suffixes
    if len(re.findall(r"[a-z][A-Z]|[A-Z]{2}[a-z]", tok)) > 1:
        return False                                   # random IDs: CeOXx-XTYek
    if len(parts) > 2:
        return False                                   # long identifiers, slugs
    if len(tok) <= 3 and not re.search(r"[A-Z0-9]", tok[1:]):
        return False                                   # dev, ssh, cli: Whisper's fine
    if tok == low or tok[1:] == tok[1:].lower():       # plain or Capitalized word
        return low not in common if name else not is_common(low, common)
    return True                                        # GitHub, CopyQ, X11


def main():
    common = common_words()
    if not common:
        sys.exit("xhisper-vocab: no word list found (install a /usr/share/dict word list)")
    now = time.time()
    score = collections.Counter()
    count = collections.Counter()
    for path in glob.glob(TRANSCRIPTS):
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            continue
        if mtime < now - DAYS * 86400:
            continue
        with open(path, errors="ignore") as f:
            for line in f:
                if '"user"' not in line:
                    continue
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                ts = entry.get("timestamp")
                try:
                    age = (now - time.mktime(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S"))) / 86400
                except (TypeError, ValueError):
                    age = (now - mtime) / 86400
                if age > DAYS:
                    continue
                weight = 0.5 ** (age / HALF_LIFE)
                for text in message_texts(entry):
                    # Once per message, so a typo repeated in one message doesn't qualify.
                    toks = {}
                    for m in TOKEN.finditer(text):
                        tok = m.group()
                        before = text[:m.start()].rstrip()
                        name = tok[0].isupper() and bool(before) and before[-1] not in ".!?:\n"
                        toks[tok] = toks.get(tok, False) or name
                    for tok, name in toks.items():
                        if interesting(tok, common, name):
                            score[tok] += weight
                            count[tok] += 1

    # Unusual words in the names of folders you work in (repos, tools) count as one
    # recent use: enough to qualify, ranked behind words you actually typed.
    try:
        for name in os.listdir(PROJECTS):
            if not name.startswith(".") and os.path.isdir(os.path.join(PROJECTS, name)):
                for part in re.split(r"[-_.]", name):
                    if interesting(part, common) and not re.search(r"\d", part):
                        score[part] += 1
                        count[part] += MIN_COUNT
    except OSError:
        pass

    # Merge spellings of one term; keep a capitalized form if you use it at least a
    # third as often as the lowercase one ("GitHub" over "github").
    merged = {}
    for tok in score:
        merged.setdefault(tok.lower(), []).append(tok)
    terms = []
    for low, forms in merged.items():
        total = sum(count[t] for t in forms)
        if total < MIN_COUNT:
            continue
        forms.sort(key=lambda t: -count[t])
        best = forms[0]
        if best == low:
            capped = [t for t in forms if t != low]
            if capped and count[capped[0]] * 3 >= count[low]:
                best = capped[0]
        terms.append((sum(score[t] for t in forms), best))
    terms.sort(key=lambda x: -x[0])
    vocab = [t for _, t in terms[:MAX_TERMS]]

    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    tmp = f"{OUT}.tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        f.write("".join(f"{t}\n" for t in vocab))
    os.replace(tmp, OUT)
    if "--print" in sys.argv:
        print(", ".join(vocab))


if __name__ == "__main__":
    main()
